# ==============================================================================
# CONFIGURAÇÃO DE SEGURANÇA E AUTENTICAÇÃO - PORTAL DE APOIO DOCENTE
# ==============================================================================

# Chave Secreta para assinatura criptográfica de sessões e cookies (gere uma chave forte para produção)
# Exemplo para gerar chave: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=substitua_por_uma_chave_aleatoria_longa_e_segura

# Ambiente de Execução (production | development)
FLASK_ENV=production
COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# CREDENCIAIS DOS 3 USUÁRIOS AUTORIZADOS
# ------------------------------------------------------------------------------

# Usuário 1 (Docente)
USER1_USERNAME=laura
USER1_NAME=Laura
USER1_PASSWORD=altere_esta_senha_1
USER1_ROLE=Docente

# Usuário 2 (Docente)
USER2_USERNAME=maria
USER2_NAME=Maria
USER2_PASSWORD=altere_esta_senha_2
USER2_ROLE=Docente

# Usuário 3 (Coordenação)
USER3_USERNAME=lucio
USER3_NAME=Lúcio Rodrigo
USER3_PASSWORD=altere_esta_senha_3
USER3_ROLE=Coordenação
